PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
# Optional additional exact origins, comma-separated; never use wildcards.
CLIENT_ORIGINS=
# Optional: omit to use none in production (HTTPS) and lax locally.
# COOKIE_SAME_SITE=none
# Optional absolute path; blank defaults to server/uploads (private local storage).
MEDIA_UPLOAD_DIR=
