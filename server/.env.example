PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
# Optional additional exact origins, comma-separated; never use wildcards.
CLIENT_ORIGINS=
# Optional: omit to use none in production (HTTPS) and lax locally.
# COOKIE_SAME_SITE=none
# Optional absolute path; blank defaults to server/uploads (private local storage).
MEDIA_UPLOAD_DIR=

# Local development saves email previews in server/mail-outbox (never commit them).
# Omit MAIL_MODE to use file locally and smtp in production.
# Production: smtp OR resend (HTTPS, suitable for hosts blocking SMTP ports).
# MAIL_MODE=file
# For real email locally, explicitly set MAIL_MODE=smtp. SMTP credentials alone
# do not switch development away from file previews.
# Optional stable secret (at least 32 characters). Keep unchanged across restarts.
# MAIL_ENCRYPTION_KEY=
MAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
